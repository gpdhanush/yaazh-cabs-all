# Optional: enables Google Places Autocomplete for pickup/drop.
# Without this key, the form falls back to OpenStreetMap + popular routes.
VITE_GOOGLE_MAPS_API_KEY=

# Backend API (Fastify on subdomain — wire bookings later)
VITE_API_URL=https://luxe-motion-ride-1.onrender.com
# Optional: OpenAI-compatible chat for the on-site assistant.
# Without these, the widget replies with a WhatsApp/call fallback.
# On cPanel static SPA, /api/chat is unavailable — WhatsApp fallback is used.
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
