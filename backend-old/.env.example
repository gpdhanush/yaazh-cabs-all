NODE_ENV=production

PORT=3000
HOST=127.0.0.1

APP_URL=https://api.yourdomain.com
PUBLIC_WEB_URL=https://yourdomain.com
API_PREFIX=/api
APP_NAME="Yaazh Cab Booking API"

# MySQL (preferred split keys — used by app + scripts)
# DB_HOST must be hostname/IP only (e.g. 127.0.0.1) — do NOT include http://
DB_HOST=localhost
DB_PORT=3306
# cPanel usually prefixes both names with the hosting account name.
DB_USER=cpanel_database_user
DB_PASSWORD=
DB_NAME=cpanel_database_name

# Optional override. If empty, built from DB_* above.
# DATABASE_URL=mysql://cpanel_database_user:password@localhost:3306/cpanel_database_name?charset=utf8mb4&connection_limit=5&pool_timeout=10&connect_timeout=10

JWT_SECRET=generate-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

REDIS_ENABLED=false

FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Yaazh Cabs"
MAIL_DEBUG=false
MAIL_LOGGER=false
MAIL_TLS_REJECT=false
MAIL_CONN_TIMEOUT=30000
MAIL_GREETING_TIMEOUT=20000
MAIL_SOCKET_TIMEOUT=45000
# Prefer IPv4 (avoids SMTP connection timeouts when IPv6 is advertised but blocked)
MAIL_IPV4=true
# EMAIL_* aliases are also accepted (EMAIL_HOST, EMAIL_USER, EMAIL_PASS, EMAIL_PORT, EMAIL_FROM, …)

SMS_ENABLED=false
WHATSAPP_ENABLED=false
PAYMENT_ENABLED=false

MAP_PROVIDER=haversine
OSRM_BASE_URL=
NOMINATIM_BASE_URL=

STORAGE_DRIVER=local
STORAGE_PATH=./storage

CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

LOG_LEVEL=warn

FEATURE_LIVE_TRACKING=true
FEATURE_WEBSOCKET=false
FEATURE_ONLINE_PAYMENT=false

# Bound Prisma connections for shared hosting.
DB_CONNECTION_LIMIT=5
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10
DB_AUTO_UTF8MB4=false
