NODE_ENV=development

PORT=3000
HOST=0.0.0.0

APP_URL=http://localhost:3000
PUBLIC_WEB_URL=https://yaazhcabs.in
API_PREFIX=/api
APP_NAME="Yaazh Cab Booking API"

# MySQL (preferred split keys — used by app + scripts)
# DB_HOST must be hostname/IP only (e.g. 127.0.0.1) — do NOT include http://
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yaazh_cab_booking

# Optional override. If empty, built from DB_* above.
# DATABASE_URL=mysql://root:@127.0.0.1:3306/yaazh_cab_booking

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

REDIS_ENABLED=false

FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Yaazh Cabs"
MAIL_DEBUG=false
MAIL_LOGGER=false
MAIL_TLS_REJECT=false
MAIL_CONN_TIMEOUT=15000
MAIL_GREETING_TIMEOUT=15000
MAIL_SOCKET_TIMEOUT=20000
# EMAIL_* aliases are also accepted (EMAIL_HOST, EMAIL_USER, EMAIL_PASS, EMAIL_PORT, EMAIL_FROM, …)

SMS_ENABLED=false
WHATSAPP_ENABLED=false
PAYMENT_ENABLED=false

MAP_PROVIDER=haversine
OSRM_BASE_URL=
NOMINATIM_BASE_URL=

STORAGE_DRIVER=local
STORAGE_PATH=./storage

CORS_ORIGINS=http://localhost:3001,http://localhost:4000,http://localhost:5173,https://yaazhcabs.in,https://www.yaazhcabs.in,http://localhost:4200,https://admin.yaazhcabs.in

LOG_LEVEL=info

FEATURE_LIVE_TRACKING=true
FEATURE_WEBSOCKET=false
FEATURE_ONLINE_PAYMENT=false

RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
