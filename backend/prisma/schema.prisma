  user_agent String? @db.VarChar(500)
  created_at DateTime @db.Timestamp(0) @default(now())
  @@index([user_type, phone, purpose, expires_at])
  @@index([user_type, email, purpose, expires_at])
  @@index([created_at])
  @@map("auth_otp_requests")
}

model AppDevices {
