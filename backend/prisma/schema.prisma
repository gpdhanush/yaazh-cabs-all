model AdminRoles {
  id BigInt @id @default(autoincrement())
  name String @db.VarChar(80) @unique
  description String? @db.VarChar(255)
  is_active Boolean @default(true)
  created_at DateTime @db.Timestamp(0) @default(now())
  updated_at DateTime? @db.Timestamp(0) @updatedAt
  @@map("admin_roles")
}

model Permissions {
  id BigInt @id @default(autoincrement())
  module String @db.VarChar(80)
  action String @db.VarChar(80)
  label String @db.VarChar(120)
  created_at DateTime @db.Timestamp(0) @default(now())
  @@unique([module, action])
  @@map("permissions")
}

model RolePermissions {
  role_id BigInt
  permission_id BigInt
  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model AdminUsers {
  id BigInt @id @default(autoincrement())
  role_id BigInt
  name String @db.VarChar(120)
  email String @db.VarChar(150) @unique
  phone String? @db.VarChar(20) @unique
  password_hash String @db.VarChar(255)
  avatar_url String? @db.VarChar(500)
  is_active Boolean @default(true)
  last_login_at DateTime? @db.DateTime(0)
  created_at DateTime @db.Timestamp(0) @default(now())
  updated_at DateTime? @db.Timestamp(0) @updatedAt
  @@index([role_id, is_active])
  @@map("admin_users")
}

model Customers {
  id BigInt @id @default(autoincrement())
  name String @db.VarChar(120)
  email String? @db.VarChar(150)
  phone String @db.VarChar(20) @unique
  alternate_phone String? @db.VarChar(20)
  password_hash String? @db.VarChar(255)
  profile_image_url String? @db.VarChar(500)
  address String? @db.Text
  city String? @db.VarChar(100)
  preferred_language PreferredLanguage @default(en)
  referral_code String? @db.VarChar(40) @unique
  referred_by_customer_id BigInt?
  email_verified_at DateTime? @db.DateTime(0)
  phone_verified_at DateTime? @db.DateTime(0)
  last_login_at DateTime? @db.DateTime(0)
  app_status CustomerAppStatus @default(active)
  is_active Boolean @default(true)
  created_at DateTime @db.Timestamp(0) @default(now())
  updated_at DateTime? @db.Timestamp(0) @updatedAt
  @@index([email])
  @@index([app_status, is_active])
  @@map("customers")
}

model Drivers {
  id BigInt @id @default(autoincrement())
  name String @db.VarChar(120)
  phone String @db.VarChar(20) @unique
  email String? @db.VarChar(150)
  password_hash String? @db.VarChar(255)
  profile_image_url String? @db.VarChar(500)
  license_no String? @db.VarChar(80)
  license_expiry_date DateTime? @db.Date
  address String? @db.Text
  online_status DriverOnlineStatus @default(offline)
  availability_status DriverAvailabilityStatus @default(available)
  current_latitude Decimal? @db.Decimal(10, 7)
  current_longitude Decimal? @db.Decimal(10, 7)
  last_location_at DateTime? @db.DateTime(0)
