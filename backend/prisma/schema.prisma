model DriverVehicleAssignments {
  id BigInt @id @default(autoincrement())
  driver_id BigInt
  vehicle_id BigInt
  assigned_from DateTime @db.DateTime(0)
  assigned_to DateTime? @db.DateTime(0)
  is_current Boolean @default(true)
  /// MySQL GENERATED ALWAYS AS (…) STORED — read-only
  current_driver_key BigInt? @default(dbgenerated())
  /// MySQL GENERATED ALWAYS AS (…) STORED — read-only
  current_vehicle_key BigInt? @default(dbgenerated())
  created_at DateTime @db.Timestamp(0) @default(now())
  updated_at DateTime? @db.Timestamp(0) @updatedAt
  @@unique([current_driver_key])
  @@unique([current_vehicle_key])
  @@index([driver_id, assigned_from])
  @@index([vehicle_id, assigned_from])
  @@map("driver_vehicle_assignments")
}

