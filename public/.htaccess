# Yaazh Cabs (luxe-motion-ride) — Apache rules for cPanel static SPA hosting
# Copied into the build public output on `npm run build`.

Options -MultiViews
DirectoryIndex index.html _shell.html
RewriteEngine On

# Invoice PDFs live on the API, not this static site
RewriteRule ^storage/public/invoices/(.+)$ https://luxe-motion-ride-1.onrender.com/api/v1/public/invoices/$1 [L,R=302]
RewriteRule ^api/v1/public/invoices/(.+)$ https://luxe-motion-ride-1.onrender.com/api/v1/public/invoices/$1 [L,R=302]

# Force HTTPS (uncomment after AutoSSL is active)
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve real files / directories first (assets, favicon, robots, shell)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# TanStack Start SPA shell (generated when spa.enabled = true)
RewriteRule ^ _shell.html [L]

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
  Header always set X-DNS-Prefetch-Control "on"
  # Update api host to your live API subdomain
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.yaazhcabs.in https://*.yaazhcabs.in https://nominatim.openstreetmap.org https://www.google-analytics.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me mailto: tel:"
</IfModule>

# Cache hashed assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
