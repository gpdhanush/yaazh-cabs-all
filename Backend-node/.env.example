NODE_ENV=production
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=yaazhcab_booking
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=5

JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_DAYS=30

# Required only for POST /api/v1/auth/admin/bootstrap; never expose this in the frontend.
ADMIN_BOOTSTRAP_KEY=
ADMIN_APP_URL=http://localhost:4200

# SMTP settings used for admin password-reset emails.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Yaazh Cabs"
MAIL_TLS_REJECT=true

# Comma-separated origins. Leave empty only for local development.
CORS_ORIGIN=http://localhost:5173